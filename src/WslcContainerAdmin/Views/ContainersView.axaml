<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WslcContainerAdmin.ViewModels"
             xmlns:models="using:WslcContainerAdmin.Models"
             x:Class="WslcContainerAdmin.Views.ContainersView"
             x:DataType="vm:ContainersViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,*">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,18">
      <StackPanel Spacing="4">
        <TextBlock Text="Containers" Classes="pageTitle" />
        <TextBlock Text="Manage your WSLc containers" Classes="pageSubtitle" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <ProgressBar IsIndeterminate="True" Width="92" Height="4" IsVisible="{Binding IsLoading}" />
        <Button Content="Refresh" Command="{Binding RefreshCommand}" />
        <Button Content="Run a container" Classes="primary" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" BorderBrush="{DynamicResource AccentBrush}" Command="{Binding OpenRunWizardCommand}" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Classes="panel" Padding="12" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <CheckBox Content="Include stopped" IsChecked="{Binding IncludeStopped}" VerticalAlignment="Center" />
        <Border Width="1" Height="24" Background="{DynamicResource BorderBrush}" Margin="6,0" />
        <Button Content="Details" Command="{Binding OpenDetailsCommand}" />
        <Button Content="Start" Command="{Binding StartSelectedCommand}" />
        <Button Content="Stop" Command="{Binding StopSelectedCommand}" />
        <Button Content="Remove" Command="{Binding RemoveSelectedCommand}" />
      </StackPanel>
    </Border>

    <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="2,0,0,10" />

    <Border Grid.Row="3" Classes="panel" Padding="0">
      <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="190,175,85,*,145,135" Margin="18,14,18,10">
          <TextBlock Grid.Column="0" Text="NAME" Classes="tableHeader" />
          <TextBlock Grid.Column="1" Text="IMAGE" Classes="tableHeader" />
          <TextBlock Grid.Column="2" Text="STATE" Classes="tableHeader" />
          <TextBlock Grid.Column="3" Text="STATUS" Classes="tableHeader" />
          <TextBlock Grid.Column="4" Text="PORTS" Classes="tableHeader" />
          <TextBlock Grid.Column="5" Text="NETWORKS" Classes="tableHeader" />
        </Grid>
        <ListBox Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedContainer}" Margin="8,0,8,8">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:ContainerInfo">
              <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,12">
                <Grid ColumnDefinitions="190,175,85,*,145,135" VerticalAlignment="Center">
                  <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Id}" FontSize="11" Classes="muted" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Image}" Classes="muted" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding State}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="{Binding Status}" Classes="muted" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="4" Text="{Binding Ports}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="5" Text="{Binding Networks}" Classes="muted" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
  </Grid>
</UserControl>
